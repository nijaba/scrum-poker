# Copy to .env and fill in. For production see README.md, "Deploying".

# Public address of the app, used for links and OAuth callbacks. https:// except on localhost
APP_BASE_URL=http://localhost:8000
# In production: APP_BASE_URL=https://poker.nijalabs.com

# Signs the session cookie: at least 32 characters, required outside localhost.
# Left as change-me on localhost, a random one is used and sign-ins end on restart.
SESSION_SECRET=change-me

# Who may create rooms, comma-separated:
#   *                          anyone signed in
#   ana@example.com            a Google account
#   github:ana-dev             a GitHub login
#   google-domain:example.com  a Google Workspace
#   github-org:acme            members of a GitHub organisation (adds the read:org scope)
ROOM_CREATOR_ALLOWLIST=

# Path of the SQLite file that holds room definitions. The image and compose file set /data/...
DATABASE_PATH=./data/scrum-poker.sqlite3

# Google and GitHub sign-in. Callbacks: <APP_BASE_URL>/auth/google/callback
# and <APP_BASE_URL>/auth/github/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Atlassian OAuth 2.0 (3LO) app for Jira Cloud. Callback: <APP_BASE_URL>/auth/atlassian/callback
# Scopes, as granular scopes in the developer console: read:board-scope:jira-software,
# read:board-scope.admin:jira-software, read:project:jira, read:issue-details:jira,
# write:issue:jira-software, read:me (offline_access is requested by the app)
ATLASSIAN_CLIENT_ID=
ATLASSIAN_CLIENT_SECRET=

# Encrypts stored Jira refresh tokens; required outside localhost. Generate one with:
#   python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
TOKEN_ENCRYPTION_KEY=

# Proxies whose X-Forwarded-Proto and X-Forwarded-For the app believes, comma-separated,
# or * for any (only when nothing but the proxy can reach the app). Default 127.0.0.1.
# The compose file in deploy/ sets *.
# FORWARDED_ALLOW_IPS=127.0.0.1

# Port the container listens on (default 8000)
# PORT=8000

# Read by deploy/docker-compose.yml when started with --env-file ../.env.
# The hostname Caddy serves and fetches a certificate for (default poker.nijalabs.com)
# SITE_HOST=poker.nijalabs.com
# The ports Caddy listens on (defaults 80 and 443). With another HTTPS port, put it in
# APP_BASE_URL and the OAuth callbacks too, for example https://poker.nijalabs.com:8443.
# Let's Encrypt checks the domain on public port 80 or 443, so keep one of them open.
# HTTP_PORT=80
# HTTPS_PORT=443

# Read by deploy/nginx/docker-compose.yml (started with --env-file ../../.env): the host
# port, on 127.0.0.1, that the host's nginx proxies to (default 8100). Change proxy_pass in
# deploy/nginx/poker.nijalabs.com.conf to match.
# APP_PORT=8100

# Development only (localhost only): a fake sign-in at /_fake-sso, and a fake Jira Cloud
# at /_fake-jira whose "SHOP board" holds the backlog file named here
# SCRUM_POKER_FAKE_SSO=1
# SCRUM_POKER_FAKE_JIRA=1
# SCRUM_POKER_FAKE_BACKLOG=tests/fixtures/fake_backlog.json
